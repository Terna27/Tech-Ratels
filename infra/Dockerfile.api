# Multi-stage Dockerfile for Go backend
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Install git and certificates
RUN apk add --no-cache git ca-certificates tzdata

# Cache dependencies
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download

# Copy source code
COPY apps/api/ ./

# Build binaries
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/worker ./cmd/worker
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/report-cron ./cmd/report-cron
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/seed ./cmd/seed
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/admin ./cmd/admin

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/migrate ./cmd/migrate

# Final runtime image
FROM alpine:3.21

WORKDIR /app

# Install ca-certificates and timezone database for Africa/Lagos
RUN apk --no-cache add ca-certificates tzdata curl

# Copy compiled binaries and migrations
COPY --from=builder /bin/server /app/server
COPY --from=builder /bin/migrate /app/migrate
COPY --from=builder /bin/worker /app/worker
COPY --from=builder /bin/report-cron /app/report-cron
COPY --from=builder /bin/seed /app/seed
COPY --from=builder /bin/admin /app/admin
COPY apps/api/migrations /app/migrations

ENV PORT=8000
ENV APP_ENV=production
ENV TZ=Africa/Lagos

RUN addgroup -S ratels && adduser -S -G ratels ratels
USER ratels

EXPOSE 8000

CMD ["/app/server"]
