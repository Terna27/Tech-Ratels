# Nigerian Ratels Management System - Environment Configuration
# Go Backend + Next.js Frontend (Phase 1 Safe Developer Defaults)

APP_ENV=development
PORT=8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/ratels_dev?sslmode=disable
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/ratels_test?sslmode=disable

# Security & Session Authentication
JWT_SECRET=dev_insecure_jwt_secret_key_change_in_production_32char_min!
JWT_EXPIRY_HOURS=24

# Contact Verification Delivery Adapter
# Safe development mode logs OTP codes to stdout without external SMS/email dispatch
DEV_DELIVERY_SAFE_MODE=true

# Foundation Configuration
# Configurable provisional name - legal registration and bank details marked pending verification
FOUNDATION_PROVISIONAL_NAME="Martins Vincent Otse Foundation"

# Timezone
TZ=Africa/Lagos

# Frontend API Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
