# ==============================================================================
# RATELS WORLDWIDE MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All production secrets must be securely supplied via Render / Cloud Secrets Manager.
# DO NOT commit real secrets or production credentials to source control.

# Core Runtime
APP_ENV=production
PORT=8000
TZ=Africa/Lagos

# Database Configuration (PostgreSQL 16 with SSL)
DATABASE_URL=postgres://ratels_user:replace_with_secure_password@dpg-xxxx.render.com:5432/ratels_db?sslmode=require
# TEST_DATABASE_URL is used exclusively during CI/local regression test runs
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/ratels_test?sslmode=disable

# Security & Session Authentication
# Must be at least 32 characters in production
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min!
JWT_EXPIRY_HOURS=24

# CORS & Domain Routing (Strict, no wildcards in production)
ALLOWED_ORIGINS=https://app.ratelsworldwide.org,https://ratelsworldwide.org
FRONTEND_BASE_URL=https://app.ratelsworldwide.org

# Contact Verification & Notifications Delivery
# Set to false in production to enable live dispatch via Brevo/Resend & Termii
DEV_DELIVERY_SAFE_MODE=false

# Email Provider Configuration (Supported: "brevo", "resend", "dev", "unconfigured")
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-replace_with_production_brevo_api_key
# RESEND_API_KEY=re_replace_with_production_resend_api_key
EMAIL_FROM_NAME="Ratels Worldwide"
EMAIL_FROM_ADDRESS="notifications@ratelsworldwide.org"
EMAIL_FROM="Ratels Worldwide <notifications@ratelsworldwide.org>"

# SMS Delivery via Termii
TERMII_API_KEY=TL_replace_with_production_termii_api_key
TERMII_SENDER_ID=RATELS

# Background Outbox Worker (Processes transactional email/SMS queues)
ENABLE_OUTBOX_WORKER=true

# Marketplace Payment Gateway (Paystack)
# Set to "paystack" for live operations, or "unconfigured" to safely disable checkout
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_replace_with_production_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_replace_with_production_paystack_public_key

# Cloudflare R2 Marketplace Media Storage (Public Catalogue Assets)
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=ratels-marketplace-assets-prod
R2_PUBLIC_DOMAIN=https://media.ratelsworldwide.org
R2_ENDPOINT=https://replace_with_cloudflare_account_id.r2.cloudflarestorage.com

# Cloudflare R2 Dedicated Private Reports Storage (Financial Audits & Impact Exports)
R2_REPORTS_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_REPORTS_ACCESS_KEY_ID=replace_with_reports_r2_access_key
R2_REPORTS_SECRET_ACCESS_KEY=replace_with_reports_r2_secret_access_key
R2_REPORTS_BUCKET_NAME=ratels-private-reports-prod
R2_REPORTS_ENDPOINT=https://replace_with_cloudflare_account_id.r2.cloudflarestorage.com

# Safeguarding & Confidential Incident Reporting
SAFEGUARDING_REPORTING_ENABLED=true
SAFEGUARDING_ENCRYPTION_KEY=replace_with_32_byte_aes_gcm_hex_key_for_safeguarding

# Operational & Scheduled Cron Shared Secrets
REPORT_CRON_SECRET=replace_with_high_entropy_secret_for_report_cron
MARKETPLACE_CRON_SECRET=replace_with_high_entropy_secret_for_marketplace_cron

# Foundation Legal Entity Configuration
FOUNDATION_PROVISIONAL_NAME="Martins Vincent Otse Foundation"

# Frontend Public API URL (Consumed by Next.js client)
NEXT_PUBLIC_API_URL=https://api.ratelsworldwide.org/api/v1
